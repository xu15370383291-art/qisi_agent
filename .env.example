# 阿里百炼 OpenAI 兼容 API 配置。不要把真实 Key 提交到代码仓库。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
CHAT_MODEL=qwen-plus
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_RETRIES=2
CHAT_TEMPERATURE=0
CHAT_MAX_TOKENS=1200
# PostgreSQL 混合检索的 Cross-Encoder 二次排序模型。
RERANKER_MODEL=BAAI/bge-reranker-base
# 模型下载失败时默认降级为混合检索排序；严格要求模型时设为 true。
RERANKER_REQUIRED=false
# 设为 false 可完全关闭 Cross-Encoder（适合无法访问 Hugging Face 的环境）。
RERANKER_ENABLED=true
# 留空时由 sentence-transformers 自动选择；CPU 部署可显式填写 cpu。
RERANKER_DEVICE=
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
# 可指定本地模型目录或 Hugging Face 缓存目录；离线部署设为 true。
RERANKER_CACHE_DIR=
RERANKER_LOCAL_FILES_ONLY=false
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database
AUTH_DB_PATH=data/runtime/auth.sqlite3
# 留空时首次启动生成并保存到 PostgreSQL runtime_settings；生产环境建议显式设置高强度随机值。
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_SECONDS=86400
# 管理员注册申请码，请在部署时设置为仅管理员知晓的值。
ADMIN_REGISTRATION_CODE=
